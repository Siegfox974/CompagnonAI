# Serveur LLM compatible OpenAI (Ollama, llama.cpp server, LM Studio, KoboldCpp...)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=mistral-nemo
LLM_API_KEY=
LLM_TEMPERATURE=0.95
LLM_MAX_TOKENS=300
LLM_TOP_P=0.95
# Pénalités de répétition (0 = aucune) : évitent qu'elle reprenne toujours les mêmes formules
LLM_FREQUENCY_PENALTY=0.6
LLM_PRESENCE_PENALTY=0.4

# Fiche personnage (dans ./characters)
CHARACTER=default

# Nombre de messages récents envoyés au LLM
CONTEXT_MESSAGES=30

PORT=3000
