# Serveur LLM compatible OpenAI (Ollama, llama.cpp server, LM Studio, KoboldCpp...)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=mistral-nemo
LLM_API_KEY=
LLM_TEMPERATURE=0.9
LLM_MAX_TOKENS=400

# Fiche personnage (dans ./characters)
CHARACTER=default

# Nombre de messages récents envoyés au LLM
CONTEXT_MESSAGES=30

PORT=3000
